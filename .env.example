# ========================================================
# The Internet's Most Unnecessary Search Engine - Configuration
# ========================================================

# Google Gemini API Key (Server-Side Only - Never Exposed to Frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL configuration
VITE_API_BASE_URL=http://localhost:8000

# Optional: Enable Client-Side Mock Mode for offline demonstrations
# VITE_USE_MOCK_API=false

# Optional: Default Gemini model (candidate fallback chain: gemini-2.5-flash -> gemini-3.6-flash -> gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
